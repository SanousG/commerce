APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
COMMERCE_DEFAULT_CURRENCY=PEN
COMMERCE_DEFAULT_INVENTORY_LOCATION_NAME="Almacén principal"
COMMERCE_DEFAULT_INVENTORY_LOCATION_CODE=MAIN
COMMERCE_INVENTORY_LOW_STOCK_THRESHOLD=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_WIDTH=6000
MEDIA_MAX_HEIGHT=6000
MEDIA_MAX_PIXELS=20000000
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
INERTIA_DEVTOOLS_ENABLED=false

SUNAT_ENVIRONMENT=BETA
SUNAT_PRODUCTION_ENABLED=false
SUNAT_BETA_WSDL="https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService?wsdl"
SUNAT_PRODUCTION_WSDL="https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService?wsdl"
SUNAT_QUERY_WSDL="https://e-factura.sunat.gob.pe/ol-it-wsconscpegem/billConsultService?wsdl"
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_STORAGE_DISK=sunat
SUNAT_CERTIFICATE_PATH=
SUNAT_CERTIFICATE_PASSWORD=
